# Copy to .env (gitignored) and edit. gcd-agent searches cwd and upward.
#
# Path to the Lean project the agent should operate on. Must contain
# lakefile.lean (or lakefile.toml). Absolute path recommended; ~ is expanded.
LEAN_REPO_PATH=/home/your-user/path/to/lean-gcd-convex-opt

# The vLLM endpoint and model are taken from your shell env, set by
# `vllm-up gcd klone-login`. You normally do NOT put them here; they live
# in your interactive shell (or ~/.bashrc) so that exiting and re-running
# vllm-up updates them in one place. Uncomment to override.
#
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=dummy
# VLLM_MODEL=Qwen/Qwen3-8B

# Optional persistent instruction file for the Lean project. Prefer placing
# this in the Lean repo as .gcd/agent.md so it travels with that project.
# LEAN_AGENT_INSTRUCTIONS=/home/your-user/path/to/lean-project/.gcd/agent.md

# Optional session-wide instruction text included in every `ask`.
# LEAN_AGENT_CONTEXT=This project solves Aristotle challenge files. Keep proof patches small.
