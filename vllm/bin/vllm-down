#!/usr/bin/env bash
# vllm-down — thin shell wrapper around slurm_ops.vllm.vllm_down.
#
# Usage:
#   vllm-down [job-name] [host] [--local-port N]
#     job-name defaults to qwen; host defaults to klone-login.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"   # repo root
exec python3 -c "
import sys
sys.path.insert(0, sys.argv[1])
from slurm_ops.vllm import main_down
raise SystemExit(main_down(sys.argv[2:]))
" "$SCRIPT_DIR" "$@"
