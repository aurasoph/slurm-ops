#!/usr/bin/env bash
# vllm-up — thin shell wrapper around slurm_ops.vllm.vllm_up.
# All logic lives in slurm_ops/vllm.py; this just lets you call it from
# the command line without firing up a notebook.
#
# Usage:
#   vllm-up [job-name] [host] [--model M] [--local-port N]
#           [--account ACCOUNT] [--partition PARTITION] [--time HH:MM:SS]
#           [--slurm-args "..."]
#
#   job-name defaults to qwen; host defaults to klone-login.
#   Defaults are stf/gpu-l40s/1 GPU/4h. For local testing:
#     vllm-up qwen-test klone-login --account amath --time 01:00:00
#
# Requires: the slurm-ops package on Python path (uv-synced or pip-installed).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"   # repo root
exec python3 -c "
import sys
sys.path.insert(0, sys.argv[1])
from slurm_ops.vllm import main_up
raise SystemExit(main_up(sys.argv[2:]))
" "$SCRIPT_DIR" "$@"
