Bootstrap: docker
From: vllm/vllm-openai:latest

# Apptainer wrapper around the official vLLM OpenAI-compatible server image.
# We don't customize anything — the upstream image already pins a working
# CUDA/torch/flash-attn combo. At runtime we bind:
#   /cache  ← HuggingFace cache (model weights persist across runs)
# and expose the OpenAI HTTP API on the port the serve.job picks.

%environment
    export HF_HOME=/cache
    export HF_HUB_ENABLE_HF_TRANSFER=1
    export VLLM_NO_USAGE_STATS=1
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    exec python -m vllm.entrypoints.openai.api_server "$@"
